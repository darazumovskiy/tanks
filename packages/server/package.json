{
  "name": "@tanks/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./bots/ladder": {
      "types": "./dist/bots/ladder.d.ts",
      "default": "./dist/bots/ladder.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "default": "./dist/room.js"
    },
    "./gameLog": {
      "types": "./dist/gameLog.d.ts",
      "default": "./dist/gameLog.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@tanks/shared": "*",
    "mmdb-lib": "^3.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
