[Unit]
Description=Tanks game server
After=network.target

[Service]
Type=simple
User=tanks
WorkingDirectory=/opt/tanks
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=STATIC_ROOT=/opt/tanks/packages/client/dist
Environment=APK_PATH=/opt/tanks-files/tanks.apk
Environment=LOG_DIR=/opt/tanks-logs
# Базы DB-IP для страны, города и провайдера визита; кладёт deploy/geo-update.
Environment=GEO_DIR=/opt/tanks-files/geo
# Скольжение вдоль стен для всех комнат, 0–100: 0 — залипание как в tank-arena, 100 — стены без трения.
Environment=WALL_SLIDE=30
# Лаг-компенсация, снаряд со скоростью танка, сглаживание сети; файл меняет админка, первый кладёт выкладка.
EnvironmentFile=-/etc/tanks/settings.env
# Коммит сборки (TANKS_BUILD) для журнала игр и /healthz; файл пишется заново перед каждым запуском, от root (+);
# сбой скрипта не мешает запуску игры (-).
ExecStartPre=-+/bin/bash /opt/tanks/deploy/build-env
EnvironmentFile=-/etc/tanks/build.env
ExecStart=/usr/bin/node /opt/tanks/packages/server/dist/main.js
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
