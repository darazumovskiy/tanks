# Старое имя остаётся навсегда: установленные APK открывают именно его и на другой адрес не переходят.
tankbattle.io, 172-232-212-157.sslip.io {
	encode zstd gzip

	# Метрики игры читает только Vector с этой же машины.
	handle /metrics {
		respond 404
	}

	# События клиента уходят во Vector, минуя игровой процесс.
	handle /telemetry {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8094
	}

	# Админка настроек боя; пароль — блок из хэша на машине, его пишет deploy-local.sh.
	redir /admin /admin/
	handle_path /admin/* {
		import /etc/caddy/admin-auth.caddy
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

www.tankbattle.io {
	redir https://tankbattle.io{uri} permanent
}
