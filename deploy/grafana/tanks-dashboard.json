{
  "uid": "tanks-main",
  "title": "Танки",
  "tags": [
    "tanks"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "platform",
        "label": "Платформа",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "query": {
          "label": "platform",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{app=\"tanks\",stream=\"client\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "type": "query",
        "name": "shell",
        "label": "Оболочка",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "query": {
          "label": "shell",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{app=\"tanks\",stream=\"client\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Сервер: ОК?",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Опоздавших тиков за 5 мин",
      "description": "Тик начался позже расписания больше чем на тик. Зелёный — игра идёт ровно, красный — игроки видят рывки.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(tanks_ticks_late_total[5m])) or vector(0)",
          "refId": "A",
          "instant": false
        }
      ],
      "id": 2
    },
    {
