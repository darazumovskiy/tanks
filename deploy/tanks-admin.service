[Unit]
Description=Tanks server settings admin
After=network.target

[Service]
Type=simple
# От root: пишет /etc/tanks/settings.env и перезапускает tanks. Наружу — только через Caddy под паролем.
WorkingDirectory=/opt/tanks
Environment=ADMIN_PORT=8090
Environment=SETTINGS_FILE=/etc/tanks/settings.env
Environment=LOG_DIR=/opt/tanks-logs
ExecStart=/usr/bin/node --import ./packages/client/test/e2e/tsLoader.mjs packages/client/test/e2e/serverAdmin.ts
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
